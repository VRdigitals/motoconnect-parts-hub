# Copy this file to .env.local for local development (it is git-ignored), and set the same names as environment
# variables on the hosting provider for production. NEVER commit real values.

# ---- Zoho Books ---------------------------------------------------------------------------------------------
# Data centre of the Zoho account: com | eu | in | com.au | jp | sa | ca  (see the web address when logged in)
ZOHO_REGION=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Created once with: node scripts/zoho-get-refresh-token.mjs
ZOHO_REFRESH_TOKEN=
# Books > Settings > Organization Profile > Organization ID
ZOHO_BOOKS_ORG_ID=

# Optional
# ZOHO_BOOKS_DEPOSIT_ACCOUNT_ID=       # Books account the Stripe payments are recorded into
# ZOHO_BOOKS_PAYMENT_MODE=creditcard   # cash | check | creditcard | banktransfer | bankremittance | autotransaction | others
# SHOP_CATEGORY_FILTER=Brakes,Lubricants   # only show items in these Books categories (comma separated)
# ZOHO_BOOKS_INVOICE_EXTRA={"place_of_supply":"DU"}   # extra JSON merged into every invoice (UAE VAT fields etc.)
# ZOHO_BOOKS_CONTACT_EXTRA={}                          # extra JSON merged into every new customer
# SHOP_CACHE_SECONDS=300               # how long the product list is cached

# ---- Stripe ---------------------------------------------------------------------------------------------------
# Use sk_test_... while testing, sk_live_... only when going live.
STRIPE_SECRET_KEY=
# From Stripe > Developers > Webhooks (endpoint: https://YOUR-SITE/api/stripe/webhook, event: checkout.session.completed
# + checkout.session.async_payment_succeeded). For local testing use the value printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# ---- Site -----------------------------------------------------------------------------------------------------
# Public address of the website (used for Stripe return links). Defaults to the address of the incoming request.
# SITE_URL=https://motoconnect.ae
# Show demo products even in production while Zoho is not connected (normally leave unset).
# SHOP_SAMPLE_DATA=true
